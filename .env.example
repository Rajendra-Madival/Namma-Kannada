# Database Connection
# Supabase PostgreSQL connection string (Transaction Pooler recommended for serverless runtimes)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.example:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Server Settings
PORT=5000
FRONTEND_ORIGIN=*
